<?xml version="1.0" encoding="UTF-8"?>
<!--

https://oversold1960.github.io/catering-addin/assets/icon-32.png

  Catering-Bestell-Add-in für Outlook (Termin-Erstellung)
  ========================================================
  WICHTIG VOR DEM PRODUKTIVEINSATZ:
  1. Ersetze https://ADD-IN-HOST.meinefirma.de/catering-addin/ überall in dieser Datei
     durch die tatsächliche HTTPS-URL, unter der die Dateien aus src/ und assets/
     gehostet werden (z. B. Azure Static Web App, IIS, SharePoint, o. Ä.).
     Outlook lädt diese Ressourcen zur Laufzeit per HTTPS – lokale Pfade reichen
     für den Produktivbetrieb NICHT aus.
  2. Ersetze die <Id> durch eine eigene, neu generierte GUID (z. B. via
     "npx uuid" oder PowerShell [guid]::NewGuid()).
  3. Passe ProviderName, SupportUrl und AppDomains an eure Domain an.
-->
<OfficeApp
    xmlns="http://schemas.microsoft.com/office/appforoffice/1.1"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:bt="http://schemas.microsoft.com/office/officeappbasictypes/1.0"
    xmlns:mailappor="http://schemas.microsoft.com/office/mailappversionoverrides/1.0"
    xsi:type="MailApp">

  <Id>6581e3d9-c9dc-478b-b4f5-3a52eccd99fc</Id>
  <Version>1.0.0.0</Version>
  <ProviderName>Bruening Group Germany GmbH</ProviderName>
  <DefaultLocale>de-DE</DefaultLocale>
  <DisplayName DefaultValue="Catering bestellen" />
  <Description DefaultValue="Bestellt Catering direkt aus dem Terminfenster heraus und sendet eine strukturierte Anfrage an catering@meinefirma.de." />
  <IconUrl DefaultValue="https://oversold1960.github.io/catering-addin/assets/icon-32.png" />
  <HighResolutionIconUrl DefaultValue="https://oversold1960.github.io/catering-addin/assets/icon-64.png" />
  <SupportUrl DefaultValue="https://www.bruening-group.de/unternehmen/historie" />

  <AppDomains>
    <AppDomain>https://github.com</AppDomain>
  </AppDomains>

  <Hosts>
    <Host Name="Mailbox" />
  </Hosts>

  <Requirements>
    <Sets>
      <Set Name="Mailbox" MinVersion="1.9" />
    </Sets>
  </Requirements>

  <Permissions>ReadWriteItem</Permissions>

  <Rule xsi:type="RuleCollection" Mode="Or">
    <Rule xsi:type="ItemIs" ItemType="Appointment" FormType="Edit" />
  </Rule>

  <DisableEntityHighlighting>false</DisableEntityHighlighting>

  <VersionOverrides xmlns="http://schemas.microsoft.com/office/mailappversionoverrides" xsi:type="VersionOverridesV1_0">

    <Requirements>
      <bt:Sets DefaultMinVersion="1.10">
        <bt:Set Name="Mailbox" />
      </bt:Sets>
    </Requirements>

    <Hosts>
      <Host xsi:type="MailHost">
        <DesktopFormFactor>

          <FunctionFile resid="Commands.Url" />

          <!-- Menüband-Erweiterung NUR im Organizer-Fenster beim Erstellen/Bearbeiten eines Termins -->
          <ExtensionPoint xsi:type="MeetingOrganizerCommandSurface">
            <OfficeTab id="TabDefault">
              <Group id="CateringGroup">
                <Label resid="CateringGroup.Label" />
                <Icon>
                  <bt:Image size="16" resid="icon-16" />
                  <bt:Image size="32" resid="icon-32" />
                  <bt:Image size="80" resid="icon-80" />
                </Icon>

                <Control xsi:type="Button" id="CateringToggleButton">
                  <Label resid="CateringButton.Label" />
                  <Supertip>
                    <Title resid="CateringButton.Label" />
                    <Description resid="CateringButton.Tooltip" />
                  </Supertip>
                  <Icon>
                    <bt:Image size="16" resid="icon-16" />
                    <bt:Image size="32" resid="icon-32" />
                    <bt:Image size="80" resid="icon-80" />
                  </Icon>
                  <!-- ExecuteFunction statt ShowTaskpane, damit wir den Button als
                       An/Aus-Umschalter (Label + Icon-Status) steuern können -->
                  <Action xsi:type="ExecuteFunction">
                    <FunctionName>toggleCateringPane</FunctionName>
                  </Action>
                </Control>

              </Group>
            </OfficeTab>
          </ExtensionPoint>

        </DesktopFormFactor>
      </Host>
    </Hosts>

    <Resources>
      <bt:Images>
        <bt:Image id="icon-16" DefaultValue="https://oversold1960.github.io/catering-addin/assets/icon-16.png" />
        <bt:Image id="icon-32" DefaultValue="https://oversold1960.github.io/catering-addin/assets/icon-32.png" />
        <bt:Image id="icon-80" DefaultValue="https://oversold1960.github.io/catering-addin/assets/icon-80.png" />
      </bt:Images>
      <bt:Urls>
        <bt:Url id="Commands.Url" DefaultValue="https://oversold1960.github.io/catering-addin/src/commands/commands.html" />
        <bt:Url id="Taskpane.Url" DefaultValue="https://oversold1960.github.io/catering-addin/src/taskpane/taskpane.html" />
      </bt:Urls>
      <bt:ShortStrings>
        <bt:String id="CateringGroup.Label" DefaultValue="Catering" />
        <bt:String id="CateringButton.Label" DefaultValue="Catering bestellen" />
      </bt:ShortStrings>
      <bt:LongStrings>
        <bt:String id="CateringButton.Tooltip" DefaultValue="Öffnet das Formular, um für diesen Termin Catering bei catering@meinefirma.de zu bestellen." />
      </bt:LongStrings>
    </Resources>

  </VersionOverrides>
</OfficeApp>
