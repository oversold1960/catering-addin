<?xml version="1.0" encoding="UTF-8"?>
<!--
  Catering-Bestell-Add-in für Outlook (Termin-Erstellung)
  ========================================================
  WICHTIG VOR DEM PRODUKTIVEINSATZ:
  1. Ersetze https://oversold1960.github.io/catering-addin/ überall in dieser Datei
     durch die tatsächliche HTTPS-URL, unter der die Dateien aus src/ und assets/
     gehostet werden (z. B. Azure Static Web App, IIS, SharePoint, o. Ä.).
     Outlook lädt diese Ressourcen zur Laufzeit per HTTPS – lokale Pfade reichen
     für den Produktivbetrieb NICHT aus.
  2. Die <Id> unten ist bereits eine echte, zufällig erzeugte GUID.
     WICHTIG: Erzeuge trotzdem eine EIGENE neue GUID für euren Tenant
     (z. B. via PowerShell [guid]::NewGuid() oder "python3 -c 'import uuid;
     print(uuid.uuid4())'") und ersetze den Wert – IDs sollen pro Add-in
     weltweit eindeutig sein.
  3. Passe ProviderName, SupportUrl und AppDomains an eure Domain an.
-->
<OfficeApp
    xmlns="http://schemas.microsoft.com/office/appforoffice/1.1"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:bt="http://schemas.microsoft.com/office/officeappbasictypes/1.0"
    xmlns:mailappor="http://schemas.microsoft.com/office/mailappversionoverrides/1.0"
    xsi:type="MailApp">

  <Id>83994dae-7382-4c11-b16d-1a205f736ac5</Id>
  <Version>1.0.0.4</Version>
  <ProviderName>Meine Firma GmbH</ProviderName>
  <DefaultLocale>de-DE</DefaultLocale>
  <DisplayName DefaultValue="Catering bestellen" />
  <Description DefaultValue="Bestellt Catering direkt aus dem Terminfenster heraus und sendet eine strukturierte Anfrage an catering@meinefirma.de." />
  <IconUrl DefaultValue="https://oversold1960.github.io/catering-addin/assets/icon-32.png" />
  <HighResolutionIconUrl DefaultValue="https://oversold1960.github.io/catering-addin/assets/icon-64.png" />
  <SupportUrl DefaultValue="https://intranet.meinefirma.de/support" />

  <AppDomains>
    <AppDomain>https://oversold1960.github.io</AppDomain>
  </AppDomains>

  <Hosts>
    <Host Name="Mailbox" />
  </Hosts>

  <Requirements>
    <Sets>
      <Set Name="Mailbox" MinVersion="1.9" />
    </Sets>
  </Requirements>

  <!-- Fallback für ältere/nicht Command-fähige Clients: einfacher Taskpane-Button
       ohne Umschalt-Logik. Muss laut Schema HIER stehen (vor Permissions/Rule) –
       eine falsche Reihenfolge führt zu generischen Installationsfehlern. -->
  <FormSettings>
    <Form xsi:type="ItemEdit">
      <DesktopSettings>
        <SourceLocation DefaultValue="https://oversold1960.github.io/catering-addin/src/taskpane/taskpane.html" />
      </DesktopSettings>
    </Form>
  </FormSettings>

  <Permissions>ReadWriteItem</Permissions>

  <Rule xsi:type="RuleCollection" Mode="Or">
    <Rule xsi:type="ItemIs" ItemType="Appointment" FormType="Edit" />
  </Rule>

  <DisableEntityHighlighting>false</DisableEntityHighlighting>

  <VersionOverrides xmlns="http://schemas.microsoft.com/office/mailappversionoverrides" xsi:type="VersionOverridesV1_0">

    <Requirements>
      <bt:Sets DefaultMinVersion="1.9">
        <bt:Set Name="Mailbox" />
      </bt:Sets>
    </Requirements>

    <Hosts>
      <Host xsi:type="MailHost">
        <DesktopFormFactor>

          <!-- Menüband-Erweiterung NUR im Organizer-Fenster beim Erstellen/Bearbeiten eines Termins -->
          <ExtensionPoint xsi:type="AppointmentOrganizerCommandSurface">
            <OfficeTab id="TabDefault">
              <Group id="CateringGroup">
                <Label resid="CateringGroup.Label" />

                <Control xsi:type="Button" id="CateringToggleButton">
                  <Label resid="CateringButton.Label" />
                  <Supertip>
                    <Title resid="CateringButton.Label" />
                    <Description resid="CateringButton.Tooltip" />
                  </Supertip>
                  <Icon>
                    <bt:Image size="16" resid="icon-16" />
                    <bt:Image size="32" resid="icon-32" />
                    <bt:Image size="80" resid="icon-80" />
                  </Icon>
                  <!-- ShowTaskpane statt ExecuteFunction: universell unterstützte
                       Standardaktion, kein eigener JS-Code nötig, der hängen bleiben
                       könnte. Kein dynamischer Umschalt-Effekt mehr, dafür zuverlässig
                       auf allen Outlook-Versionen/-Plattformen. -->
                  <Action xsi:type="ShowTaskpane">
                    <SourceLocation resid="Taskpane.Url" />
                  </Action>
                </Control>

              </Group>
            </OfficeTab>
          </ExtensionPoint>

        </DesktopFormFactor>
      </Host>
    </Hosts>

    <Resources>
      <bt:Images>
        <bt:Image id="icon-16" DefaultValue="https://oversold1960.github.io/catering-addin/assets/icon-16.png" />
        <bt:Image id="icon-32" DefaultValue="https://oversold1960.github.io/catering-addin/assets/icon-32.png" />
        <bt:Image id="icon-80" DefaultValue="https://oversold1960.github.io/catering-addin/assets/icon-80.png" />
      </bt:Images>
      <bt:Urls>
        <bt:Url id="Taskpane.Url" DefaultValue="https://oversold1960.github.io/catering-addin/src/taskpane/taskpane.html" />
      </bt:Urls>
      <bt:ShortStrings>
        <bt:String id="CateringGroup.Label" DefaultValue="Catering" />
        <bt:String id="CateringButton.Label" DefaultValue="Catering bestellen" />
      </bt:ShortStrings>
      <bt:LongStrings>
        <bt:String id="CateringButton.Tooltip" DefaultValue="Öffnet das Formular, um für diesen Termin Catering bei catering@meinefirma.de zu bestellen." />
      </bt:LongStrings>
    </Resources>

  </VersionOverrides>
</OfficeApp>
